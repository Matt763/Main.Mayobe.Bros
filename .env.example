# Existing env vars (not enumerated here — keep your current .env intact).
# This file documents env vars added by recent slices.

# ─── Media Optimization (Slice 3) — Bunny Stream video hosting ───────────────

# Stream library API key from bunny.net dashboard → Stream → your library → API.
BUNNY_STREAM_API_KEY=

# Numeric library ID from the same page.
BUNNY_STREAM_LIBRARY_ID=

# HMAC signing secret. Set the same value in your Bunny Stream library's
# Webhook configuration AND here. Used to verify webhook authenticity.
BUNNY_WEBHOOK_SECRET=

# Pull zone hostname for HLS / poster URLs. Example: vz-abc12345.b-cdn.net
# Available in Stream library → Players & Embed → "Direct play URL" base.
BUNNY_CDN_HOST=
