# ═══════════════════════════════════════════════════════════════════════════════
# Mayobe Bros — .env.example
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env (local) and set every value before `npm run dev`.
# For Vercel deployment: Settings → Environment Variables → add each key below,
# scoped to Production (and Preview if you want preview deploys to work).
#
# Variables prefixed with VITE_ are exposed to the browser bundle — they must
# never hold secrets. Server-only secrets stay un-prefixed.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Core: Server ────────────────────────────────────────────────────────────

# Port the Express API listens on locally. Vercel ignores this (serverless).
PORT=3001

# Node env. Set to 'production' on Vercel automatically.
NODE_ENV=development

# Public URL of the site. Used by the server (newsletter, search-engine ping,
# loopback HTTP from APL to /api/editor-ai/*) and as the OG/canonical base.
# Production: https://mayobebros.com
SITE_URL=http://localhost:3001

# Express session signing key — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Notification destination for admin contact-form alerts.
ADMIN_CONTACT_EMAIL=


# ─── Core: Frontend (Vite — VITE_ prefix, exposed to browser) ────────────────

# Mirror of SITE_URL for browser-side use.
VITE_SITE_URL=http://localhost:5173

# Mirror of SUPABASE_URL — the browser uses these for direct-from-frontend
# Supabase calls (auth, public reads).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ─── Supabase ────────────────────────────────────────────────────────────────

# Project URL — from Supabase Dashboard → Settings → API.
SUPABASE_URL=

# Service-role key (NEVER expose to browser) — full write access used by the
# Express backend for admin operations, RLS-bypassing inserts (post_embeddings,
# auto_post_queue, videos, etc.).
SUPABASE_SERVICE_ROLE_KEY=


# ─── AI: Anthropic Claude ────────────────────────────────────────────────────

# Used by all /api/editor-ai/* endpoints (Slice 1) and APL article generation.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=


# ─── AI: OpenAI (Slice 2 APL — embeddings + image generation) ────────────────

# Required for:
#  - text-embedding-3-small (1536-dim) for semantic dedup
#  - gpt-image-1 (quality='high') for autopilot featured images
# Get one at https://platform.openai.com/api-keys
# Estimated cost at 10 posts/day: ~$130/mo (mostly the high-quality images).
OPENAI_API_KEY=


# ─── AI: Google Gemini (optional, used by some legacy editor-ai paths) ───────

GEMINI_API_KEY=


# ─── APL (Slice 2): cron secret + optional threshold overrides ───────────────

# Shared secret between GitHub Actions cron and the /api/cron/autopilot-tick
# endpoint. Must match the CRON_SECRET in the GitHub repo's Actions secrets.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional QA gate thresholds (defaults shown). Override only if you want to
# tighten or loosen the publish bar.
# APL_MIN_WORDS=1200
# APL_MIN_SEO=70
# APL_MIN_ADSENSE=80
# APL_MIN_ORIGINALITY=80
# APL_TITLE_DEDUP=0.25     # cosine threshold (>= rejects)
# APL_CONTENT_DEDUP=0.30


# ─── Bunny Stream (Slice 3: media optimization — video hosting) ──────────────

# Sign up at https://bunny.net/ → Stream → create a library, then:

# Stream library API key. Settings → Stream → your library → API.
BUNNY_STREAM_API_KEY=

# Numeric library ID (same page).
BUNNY_STREAM_LIBRARY_ID=

# HMAC signing secret. Configure the webhook in Stream library settings:
#   URL:    https://mayobebros.com/api/webhooks/bunny
#   Events: Video encoded, Video failed
# Copy the generated webhook secret here AND keep the configured URL in sync.
BUNNY_WEBHOOK_SECRET=

# Pull-zone hostname for HLS / poster URLs. Stream library → Players & Embed →
# "Direct play URL" base. Example: vz-abc12345.b-cdn.net (no https://, no path)
BUNNY_CDN_HOST=


# ─── Email (Resend — newsletter + transactional) ─────────────────────────────

RESEND_API_KEY=
# Verified sending address from Resend (e.g., "Mayobe Bros <hello@mayobebros.com>")
RESEND_FROM_EMAIL=


# ─── Payments: Pesapal (East Africa premium subscriptions) ───────────────────

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_CALLBACK_URL=
PESAPAL_IPN_URL=
PESAPAL_IPN_ID=

# Premium product config used by checkout.
PREMIUM_PRICE=
PREMIUM_CURRENCY=USD


# ─── SEO: Google Indexing API + IndexNow ─────────────────────────────────────

# Service-account JSON key for Google Indexing API (one-line escaped JSON or
# path to a file, depending on how your loader reads it).
GOOGLE_INDEXING_API_KEY=


# ─── Optional: Vercel deployment automation (only if you use it) ─────────────
# These are for scripts that POST to Vercel's API on your behalf (e.g.,
# automated env-var sync). Not used by the app at runtime — leave blank if
# you're managing deploys via the Vercel dashboard or git pushes.

# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_GITHUB_REPO_ID=


# ─── Optional: GitHub integration (issue-tracking, releases, etc.) ───────────

# Personal Access Token with appropriate scopes. Same caveat as Vercel — only
# used by helper scripts, not by the runtime app.
# GITHUB_TOKEN=
# GITHUB_REPO=mbagamclean/Main.Mayobe.Bros
# GITHUB_BRANCH=main
