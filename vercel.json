{
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*",    "destination": "/api/index" },
    { "source": "/sitemap.xml",   "destination": "/api/index" },
    { "source": "/feed.xml",      "destination": "/api/index" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
